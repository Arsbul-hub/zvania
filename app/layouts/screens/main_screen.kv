<MainScreen>:
    MDFloatLayout:
        size_hint: 1, 1
        md_bg_color: "white"
        MDLabel:
            size_hint_y: None
            height: dp(30)
            pos_hint: {"center_x": 0.5, "center_y": 0.8}
            allow_selection: True
            halign: "center"
            font_style: "Headline"
            font_size: "32sp"
            text: "Тренировка знания погон и званий"
        MDCircularProgressIndicator:
            id: spinner
            size_hint: None, None
            size: "48dp", "48dp"
            pos_hint: {'center_x': .5, 'center_y': .5}

        MDAnchorLayout:
            padding: dp(30)

            anchor_x: "center"
            anchor_y: "bottom"
            MDButton:
                id: start_btn
                style: "tonal"
                on_release: root.start()
                theme_width: "Custom"

                size_hint_x: 0.5
                disabled: True

                MDButtonText:
                    text: "Начать"
                    color: "black"
                    theme_font_size: "Custom"
                    font_size: sp(20)

                    pos_hint: {"center_x": .5, "center_y": .5}

