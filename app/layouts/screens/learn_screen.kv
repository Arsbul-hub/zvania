<LearnScreen>:
    MDFloatLayout:
        md_bg_color: "white"
        MDAnchorLayout:

            padding: [back_button.width + dp(30), back_button.height + dp(30), 0, 0]
            pos_hint: {"center_x": 0, "center_y": 1}

            MDIconButton:
                id: back_button
                style: "tonal"
                icon: "arrow-left"
                on_release: root.back_to_main_screen()
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: 0.6
            spacing: dp(70)
            padding: [0, 0, 0, dp(20)]
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

            FitImage:
                id: card
                fit_mode: "contain"
                md_bg_color: "green"


            MDLabel:
                id: card_text
                size_hint_y: None
                height: dp(30)
                allow_selection: True
                halign: "center"
                font_style: "Headline"
                font_size: "32sp"

        MDAnchorLayout:
            anchor_x: "center"
            anchor_y: "bottom"
            MDBoxLayout:
                spacing: dp(20)
                adaptive_height: True
                adaptive_width: True
                padding: [0, 0, 0, dp(20)]
                MDButton:
                    id: show_answer_button
                    style: "elevated"
                    on_release: root.show_answer()
                    MDButtonText:
                        text: "Показать ответ"

                MDButton:
                    id: next_card
                    style: "elevated"
                    on_release: root.next_card()
                    disabled: True
                    MDButtonText:
                        text: "Следующая карточка"




